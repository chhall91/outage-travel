{
  "name": "outage-travel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5175",
    "build": "vite build",
    "build:pages": "GH_PAGES=1 vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4175",
    "test": "vitest run",
    "data": "python3 scripts/build-data.py",
    "status": "node scripts/fetch-status.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "forum:server": "node server/forum-server.mjs",
    "build:tunnel": "VITE_FORUM_API=/api vite build --outDir dist-tunnel"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "fflate": "^0.8.3",
    "qrcode-generator": "^2.0.4"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.10.0"
  }
}
