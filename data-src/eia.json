{"objectIdFieldName":"FID","uniqueIdField":{"name":"FID","isSystemMaintained":true},"globalIdFieldName":"","geometryType":"esriGeometryPoint","spatialReference":{"wkid":102100,"latestWkid":3857},"fields":[{"name":"Plant_Code","type":"esriFieldTypeInteger","alias":"Energy Information Administration (EIA) Power Plant Identification Number","sqlType":"sqlTypeInteger","domain":null,"defaultValue":null,"description":"{\"value\":\"A unique identification number assigned by the Energy Information Administration (EIA) to each power plant. This identifier is used across EIA surveys and reporting systems.\",\"fieldValueType\":\"uniqueIdentifier\"}"},{"name":"Plant_Name","type":"esriFieldTypeString","alias":"Electric Power Plant Name","sqlType":"sqlTypeNVarchar","length":58,"domain":null,"defaultValue":null,"description":"{\"value\":\"The official name of the electric power plant as reported to the Energy Information Administration (EIA). Plant names are used for identification, reporting, and public reference.\",\"fieldValueType\":\"nameOrTitle\"}"},{"name":"Utility_Na","type":"esriFieldTypeString","alias":"Operating Utility Name","sqlType":"sqlTypeNVarchar","length":65,"domain":null,"defaultValue":null,"description":"{\"value\":\"The name of the utility responsible for day-to-day operations of the power plant. This field reflects operational control rather than ownership in all cases.\",\"fieldValueType\":\"nameOrTitle\"}"},{"name":"City","type":"esriFieldTypeString","alias":"Plant City Location","sqlType":"sqlTypeNVarchar","length":27,"domain":null,"defaultValue":null,"description":"{\"value\":\"The city or municipality in which the power plant is located. This field supports geographic organization and regional analysis.\",\"fieldValueType\":\"locationOrPlaceName\"}"},{"name":"County","type":"esriFieldTypeString","alias":"Plant County Location","sqlType":"sqlTypeNVarchar","length":25,"domain":null,"defaultValue":null,"description":"{\"value\":\"The county containing the po